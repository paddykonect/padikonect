// Paddykonect backend — Prisma schema
// Models are added incrementally, phase by phase (see /docs and the build plan).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// --- Phase 1: Auth/Identity ---

enum UserRole {
  MEMBER
  ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
  DELETED
}

enum OtpPurpose {
  SIGNUP_VERIFICATION
  PASSWORD_RESET
}

model User {
  id           String        @id @default(uuid())
  fullName     String
  phone        String        @unique
  email        String        @unique
  passwordHash String
  role         UserRole      @default(MEMBER)
  status       AccountStatus @default(PENDING_VERIFICATION)
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sessions         Session[]
  otpVerifications OtpVerification[]
  profile          Profile?
  posts            Post[]
  eventsHosted     Event[]                    @relation("EventHost")
  rsvps            Rsvp[]
  conversationMemberships ConversationParticipant[]
  notifications    Notification[]
  webauthnCredentials     WebauthnCredential[]

  @@index([status])
}

// Postgres is the system of record for sessions (durable, admin-revocable);
// Redis (see RedisModule) holds only ephemeral rate-limit/lockout state.
model Session {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String
  previousTokenHash String?
  userAgent         String?
  ipAddress         String?
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model OtpVerification {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose      OtpPurpose
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int        @default(0)
  resendCount  Int        @default(0)
  lastSentAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
}

// --- Phase 2: Profile ---

enum DrinkPreference {
  ALCOHOLIC
  NON_ALCOHOLIC
  BOTH
}

model Profile {
  id              String          @id @default(uuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String?
  photoUrl        String?
  photoPublicId   String?
  bio             String?         @db.VarChar(280)
  drinkPreference DrinkPreference @default(BOTH)
  interests       String[]
  // Onboarding location sub-flow (Figma-only, not in the PRD — added at the
  // user's explicit request). country/state use Nigeria's states where
  // applicable; nationality is only set when the user confirms it matches
  // their country of residence.
  country         String?
  nationality     String?
  state           String?
  // MVP placeholder — read-only display value. A future Padi Points
  // ledger table (Padi Deals, product-roadmap Phase 2, out of scope here)
  // will likely replace this with a derived balance.
  padiPoints      Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// --- Biometric login (WebAuthn/passkeys) ---
// Figma-only addition (biometric enrollment screens), not in the PRD — built
// at the user's explicit request as a full slice alongside the country/state
// onboarding addition. One row per registered authenticator (a user could
// register more than one device).
model WebauthnCredential {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String[]
  deviceType   String
  backedUp     Boolean  @default(false)
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

// --- Phase 3: Feed (posts only) ---
// Event linkage (a post attached to a hangout) is added once Event exists in
// Phase 4/5 — not built ahead of time.

enum PostType {
  MOMENT
  STORY
  POLL
}

enum PostVisibility {
  PUBLIC
}

enum MediaType {
  IMAGE
  VIDEO
}

model Post {
  id         String         @id @default(uuid())
  authorId   String
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type       PostType       @default(MOMENT)
  caption    String?        @db.VarChar(2000)
  visibility PostVisibility @default(PUBLIC)
  isDeleted  Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  media PostMedia[]

  @@index([authorId, createdAt])
  @@index([createdAt])
}

model PostMedia {
  id         String    @id @default(uuid())
  postId     String
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  url        String
  publicId   String
  type       MediaType
  width      Int?
  height     Int?
  durationMs Int?
  position   Int       @default(0)

  @@index([postId])
}

// --- Phase 4: Padi Board / Events + RSVP ---

enum EventJoinPolicy {
  OPEN
  APPROVAL
}

enum EventPrivacy {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum EventDrinkCategory {
  ALCOHOLIC
  NON_ALCOHOLIC
  BOTH
}

// "Ended" is intentionally not a stored state — it's computed from `startAt`/
// `endAt` at read time, since it's a pure function of the current time.
enum EventStatus {
  PUBLISHED
  CANCELLED
}

model Event {
  id                 String             @id @default(uuid())
  hostId             String
  host               User               @relation("EventHost", fields: [hostId], references: [id])
  title              String
  description        String?            @db.VarChar(2000)
  addressText        String
  latitude           Float
  longitude          Float
  // Authoritative geo column, synced via raw SQL (see GeoRepository) in the
  // same transaction as every latitude/longitude write. Prisma Client never
  // reads/writes this directly — see plan §RSVP/capacity concurrency & geo.
  location           Unsupported("geometry(Point, 4326)")?
  startAt            DateTime
  endAt              DateTime?
  capacity           Int
  priceKobo          Int?
  coverImageUrl      String?
  coverImagePublicId String?
  // Defaulted to APPROVAL for every host regardless of track record — the PRD
  // leaves the auto-approve-vs-approval default an open product question (see
  // plan §Open questions); APPROVAL is the safer choice until that's resolved.
  joinPolicy         EventJoinPolicy    @default(APPROVAL)
  privacy            EventPrivacy       @default(PUBLIC)
  drinkCategory      EventDrinkCategory @default(BOTH)
  status             EventStatus        @default(PUBLISHED)
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  rsvps        Rsvp[]
  conversation Conversation?

  @@index([hostId])
  @@index([startAt])
  @@index([status, startAt])
}

enum RsvpStatus {
  REQUESTED
  APPROVED
  DECLINED
  WAITLISTED
  CANCELLED
  ATTENDED
}

model Rsvp {
  id               String     @id @default(uuid())
  eventId          String
  event            Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           RsvpStatus
  waitlistPosition Int?
  respondedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Backs the join-concurrency mechanism (see plan §RSVP/capacity
  // concurrency) as well as re-join-after-cancel upserts.
  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId, status])
}

// Message/MessageReceipt land in the PadiChat phase — only the schema needed
// to auto-create an event-scoped conversation on RSVP approval is built now.
enum ConversationType {
  DIRECT
  EVENT
}

model Conversation {
  id            String           @id @default(uuid())
  type          ConversationType
  eventId       String?          @unique
  event         Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())

  participants ConversationParticipant[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

// The `notifications` module (plan §Module map) was not assigned a numbered
// build phase, but the PRD explicitly requires it for two Events edge cases
// below (host edits/cancels a hangout after people have joined). Built
// minimal and IN_APP-only here — PUSH is an inert enum value until a push
// vendor is chosen (see plan §Open questions); more NotificationType values
// are added as later phases (RSVP responses, verification, subscriptions)
// need them, not pre-built now.
enum NotificationType {
  EVENT_CANCELLED
  EVENT_UPDATED
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
