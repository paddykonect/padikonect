// Paddykonect backend — Prisma schema
// Models are added incrementally, phase by phase (see /docs and the build plan).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// --- Phase 1: Auth/Identity ---

enum UserRole {
  MEMBER
  ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
  DELETED
}

enum OtpPurpose {
  SIGNUP_VERIFICATION
  PASSWORD_RESET
  // Settings > Phone & email: confirms new contact details before saving.
  CONTACT_CHANGE
}

model User {
  id           String        @id @default(uuid())
  fullName     String
  // Nullable for Google sign-in accounts: Google shares no phone number and
  // those users have no password until they set one via forgot-password.
  phone        String?       @unique
  email        String        @unique
  passwordHash String?
  googleId     String?       @unique
  // Collected on email signup (server enforces 18+). Nullable because Google
  // sign-in and accounts created before this field existed don't have one.
  dateOfBirth  DateTime?     @db.Date
  role         UserRole      @default(MEMBER)
  status       AccountStatus @default(PENDING_VERIFICATION)
  lastLoginAt  DateTime?
  // Presence: bumped (throttled) on authenticated requests; "online" is
  // derived as lastSeenAt within PRESENCE_WINDOW_MS (see presence.ts).
  lastSeenAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sessions                Session[]
  otpVerifications        OtpVerification[]
  profile                 Profile?
  posts                   Post[]
  eventsHosted            Event[]                   @relation("EventHost")
  rsvps                   Rsvp[]
  conversationMemberships ConversationParticipant[]
  notifications           Notification[]
  webauthnCredentials     WebauthnCredential[]
  venueFavorites          VenueFavorite[]
  padiConnections         PadiConnection[]          @relation("PadiOwner")
  padiOf                  PadiConnection[]          @relation("PadiTarget")
  statuses                PadiStatus[]
  messages                Message[]
  communitiesCreated      Community[]
  communityMemberships    CommunityMember[]
  liveLocation            LiveLocation?
  statusViews             StatusView[]
  blocksMade              Block[]                   @relation("Blocker")
  blockedBy               Block[]                   @relation("Blocked")
  supportMessages         SupportMessage[]
  venueReviews            VenueReview[]
  eventInvites            EventInvite[]
  radarHidesMade          RadarHide[]               @relation("RadarHider")
  radarHiddenFrom         RadarHide[]               @relation("RadarHiddenFrom")
  padiRatingsGiven        PadiRating[]              @relation("PadiRater")
  padiRatingsReceived     PadiRating[]              @relation("PadiRatee")
  eventFavorites          EventFavorite[]

  @@index([status])
}

// Postgres is the system of record for sessions (durable, admin-revocable);
// Redis (see RedisModule) holds only ephemeral rate-limit/lockout state.
model Session {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String
  previousTokenHash String?
  userAgent         String?
  ipAddress         String?
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model OtpVerification {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose      OtpPurpose
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int        @default(0)
  resendCount  Int        @default(0)
  lastSentAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
}

// --- Phase 2: Profile ---

enum DrinkPreference {
  ALCOHOLIC
  NON_ALCOHOLIC
  BOTH
}

model Profile {
  id                String          @id @default(uuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String?
  photoUrl          String?
  photoPublicId     String?
  bio               String?         @db.VarChar(280)
  drinkPreference   DrinkPreference @default(BOTH)
  interests         String[]
  // Profile card ("Wants to be invited for") — a short free-text hint shown on
  // your profile about the kinds of hangouts you'd like invites to.
  wantsToBeInvitedFor String?       @db.VarChar(80)
  // Onboarding location sub-flow (Figma-only, not in the PRD — added at the
  // user's explicit request). country/state use Nigeria's states where
  // applicable; nationality is only set when the user confirms it matches
  // their country of residence.
  country           String?
  nationality       String?
  state             String?
  // MVP placeholder — read-only display value. A future Padi Points
  // ledger table (Padi Deals, product-roadmap Phase 2, out of scope here)
  // will likely replace this with a derived balance.
  padiPoints        Int             @default(0)
  // Settings > Preferences / Privacy & safety.
  invitePolicy      InvitePolicy    @default(EVERYONE)
  pushNotifications Boolean         @default(true)
  locationServices  Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// Who may send you hangout invites (Settings > Who can invite me). Doesn't
// affect requests to join public hangouts.
enum InvitePolicy {
  EVERYONE
  PADIS_ONLY
  NO_ONE
}

// --- Biometric login (WebAuthn/passkeys) ---
// Figma-only addition (biometric enrollment screens), not in the PRD — built
// at the user's explicit request as a full slice alongside the country/state
// onboarding addition. One row per registered authenticator (a user could
// register more than one device).
model WebauthnCredential {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]
  deviceType   String
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

// --- Phase 3: Feed (posts only) ---
// Event linkage (a post attached to a hangout) is added once Event exists in
// Phase 4/5 — not built ahead of time.

enum PostType {
  MOMENT
  STORY
  POLL
}

enum PostVisibility {
  PUBLIC
}

enum MediaType {
  IMAGE
  VIDEO
}

model Post {
  id         String         @id @default(uuid())
  authorId   String
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type       PostType       @default(MOMENT)
  caption    String?        @db.VarChar(2000)
  visibility PostVisibility @default(PUBLIC)
  isDeleted  Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  media PostMedia[]

  @@index([authorId, createdAt])
  @@index([createdAt])
}

model PostMedia {
  id         String    @id @default(uuid())
  postId     String
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  url        String
  publicId   String
  type       MediaType
  width      Int?
  height     Int?
  durationMs Int?
  position   Int       @default(0)

  @@index([postId])
}

// --- Phase 4: Padi Board / Events + RSVP ---

enum EventJoinPolicy {
  OPEN
  APPROVAL
}

// Hangouts at a listed venue wait for the venue to confirm before they go
// live (Figma "Confirm with venue" / "Waiting" / "Confirmed" / "Rejected").
// Hangouts at a free-form address skip this (NOT_REQUIRED).
enum VenueApproval {
  NOT_REQUIRED
  PENDING
  CONFIRMED
  REJECTED
}

enum EventPrivacy {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum EventDrinkCategory {
  ALCOHOLIC
  NON_ALCOHOLIC
  BOTH
}

// "Ended" is intentionally not a stored state — it's computed from `startAt`/
// `endAt` at read time, since it's a pure function of the current time.
enum EventStatus {
  PUBLISHED
  CANCELLED
}

model Event {
  id                 String                                @id @default(uuid())
  hostId             String
  host               User                                  @relation("EventHost", fields: [hostId], references: [id])
  title              String
  description        String?                               @db.VarChar(2000)
  addressText        String
  latitude           Float
  longitude          Float
  // Authoritative geo column, synced via raw SQL (see GeoRepository) in the
  // same transaction as every latitude/longitude write. Prisma Client never
  // reads/writes this directly — see plan §RSVP/capacity concurrency & geo.
  location           Unsupported("geometry(Point, 4326)")?
  startAt            DateTime
  endAt              DateTime?
  capacity           Int
  priceKobo          Int?
  coverImageUrl      String?
  coverImagePublicId String?
  // Defaulted to APPROVAL for every host regardless of track record — the PRD
  // leaves the auto-approve-vs-approval default an open product question (see
  // plan §Open questions); APPROVAL is the safer choice until that's resolved.
  joinPolicy         EventJoinPolicy                       @default(APPROVAL)
  privacy            EventPrivacy                          @default(PUBLIC)
  drinkCategory      EventDrinkCategory                    @default(BOTH)
  // Interest tags (same vocabulary as Profile.interests / the Taste Picker),
  // filtered by Home's interest chips.
  tags               String[]                              @default([])
  status             EventStatus                           @default(PUBLISHED)
  venueId            String?
  venue              Venue?                                @relation(fields: [venueId], references: [id], onDelete: SetNull)
  venueApproval      VenueApproval                         @default(NOT_REQUIRED)
  // Set when the host sends the in-app confirmation request to the venue.
  venueRequestedAt   DateTime?
  venueRespondedAt   DateTime?
  // Optional note from the venue with its decision (shown on rejection).
  venueNote          String?                               @db.VarChar(500)
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime                              @default(now())
  updatedAt          DateTime                              @updatedAt

  rsvps        Rsvp[]
  invites      EventInvite[]
  conversation Conversation?
  padiRatings  PadiRating[]
  favorites    EventFavorite[]

  @@index([hostId])
  @@index([venueId])
  @@index([startAt])
  @@index([status, startAt])
  @@index([tags], type: Gin)
}

enum RsvpStatus {
  REQUESTED
  APPROVED
  DECLINED
  WAITLISTED
  CANCELLED
  ATTENDED
}

model Rsvp {
  id               String     @id @default(uuid())
  eventId          String
  event            Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           RsvpStatus
  waitlistPosition Int?
  // The requester's optional note to the host ("Message from Chidinma").
  message          String?    @db.VarChar(280)
  // The host's optional note sent back with an accept/decline.
  decisionNote     String?    @db.VarChar(150)
  // Entry pass shown as a QR code once approved; the host scans it at the
  // door (check-in marks the RSVP ATTENDED). Generated on first view.
  passCode         String?    @unique
  checkedInAt      DateTime?
  respondedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Backs the join-concurrency mechanism (see plan §RSVP/capacity
  // concurrency) as well as re-join-after-cancel upserts.
  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId, status])
}

// PadiChat: event-scoped group chats (auto-created with the hangout, members
// added on RSVP approval) and one-to-one DIRECT chats between padis.
enum ConversationType {
  DIRECT
  EVENT
  COMMUNITY
}

model Conversation {
  id            String           @id @default(uuid())
  type          ConversationType
  eventId       String?          @unique
  // DIRECT only: the two user ids sorted and joined with ':' — one thread per pair.
  directKey     String?          @unique
  communityId   String?          @unique
  community     Community?       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  event         Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?
  // Messages after this are unread for this participant.
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

// The `notifications` module (plan §Module map) was not assigned a numbered
// build phase, but the PRD explicitly requires it for two Events edge cases
// below (host edits/cancels a hangout after people have joined). Built
// minimal and IN_APP-only here — PUSH is an inert enum value until a push
// vendor is chosen (see plan §Open questions); more NotificationType values
// are added as later phases (RSVP responses, verification, subscriptions)
// need them, not pre-built now.
enum NotificationType {
  EVENT_CANCELLED
  EVENT_UPDATED
  EVENT_INVITE
  RSVP_REQUESTED
  RSVP_APPROVED
  RSVP_DECLINED
  VENUE_CONFIRMED
  VENUE_REJECTED
  VENUE_REQUEST
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// --- Home screen: venues/favourites, padis, statuses ---
// Figma-only (Home node 590:8834), built at the user's explicit request ahead
// of the PRD's Padi Deals / PadiRadar phases. Venues are seeded/admin-managed
// reference data for now (no venue-owner accounts yet).

enum VenueCategory {
  RESTAURANT
  LOUNGE
  REGISTERED_LOUNGE
  BAR
  ROOFTOP
  CAFE
}

model Venue {
  id            String        @id @default(uuid())
  name          String
  category      VenueCategory
  addressText   String
  latitude      Float
  longitude     Float
  coverImageUrl String?
  // Venue detail (Figma "Venue detail / Overview|Menu|Review|Events").
  description   String?       @db.VarChar(1000)
  phone         String?
  photos        String[]      @default([])
  amenities     String[]      @default([])
  // Daily opening hours in Lagos time, "HH:mm". Null = hours unknown.
  opensAt       String?
  closesAt      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  favorites VenueFavorite[]
  menuItems VenueMenuItem[]
  reviews   VenueReview[]
  events    Event[]

  @@index([name])
}

model VenueFavorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, venueId])
  @@index([userId, createdAt])
}

// Saved hangouts (the heart on a hangout card). Mirrors VenueFavorite.
model EventFavorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, eventId])
  @@index([userId, createdAt])
}

// One-directional, like "following": userId added padiId (e.g. via Scan padi).
model PadiConnection {
  userId    String
  user      User     @relation("PadiOwner", fields: [userId], references: [id], onDelete: Cascade)
  padiId    String
  padi      User     @relation("PadiTarget", fields: [padiId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, padiId])
  @@index([padiId])
}

// 24h status (story). Text and/or an image (uploaded to Cloudinary client-side).
model PadiStatus {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String?  @db.VarChar(280)
  imageUrl  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  views StatusView[]

  @@index([userId, expiresAt])
}

model StatusView {
  statusId String
  status   PadiStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewerId String
  viewer   User       @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt DateTime   @default(now())

  @@id([statusId, viewerId])
  @@index([viewerId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String       @db.VarChar(2000)
  // Client-generated id so a "tap to retry" resend can't create a duplicate.
  clientId       String
  createdAt      DateTime     @default(now())

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt])
}

// --- Communities (Figma "Communities", html export node 560:3018) ---
// Interest groups; each has its own group chat (Conversation type COMMUNITY).
// Age range is informational until profiles carry a date of birth.

enum CommunityRole {
  OWNER
  MEMBER
}

model Community {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(60)
  description String   @db.VarChar(280)
  emoji       String   @db.VarChar(16)
  city        String   @db.VarChar(60)
  minAge      Int      @default(18)
  maxAge      Int      @default(99)
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  members      CommunityMember[]
  conversation Conversation?

  @@index([city])
}

model CommunityMember {
  communityId String
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  @@id([communityId, userId])
  @@index([userId])
}

// --- PadiRadar: opt-in live location for padis (Home "Padis" tab) ---
// A row exists only while the user is sharing; turning sharing off deletes
// it. Coordinates are stored pre-rounded (~100m) and shown only to people the
// sharer has added as padis, and only while fresh (see RadarService).
model LiveLocation {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// Settings > Blocked padis. Blocking is one-way to create but hides both
// people from each other (profiles, hangouts, chat, padis, radar).
model Block {
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

enum SupportTopic {
  HANGOUTS
  REWARDS
  REPORT_PADI
  OTHER
}

// Settings > Contact us ("Or send us a message").
model SupportMessage {
  id        String       @id @default(uuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  topic     SupportTopic
  message   String       @db.VarChar(2000)
  createdAt DateTime     @default(now())

  @@index([createdAt])
}

model VenueMenuItem {
  id        String @id @default(uuid())
  venueId   String
  venue     Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  section   String
  name      String
  priceKobo Int
  position  Int    @default(0)

  @@index([venueId, position])
}

model VenueReview {
  id        String   @id @default(uuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One review per padi per venue; writing again edits it.
  @@unique([venueId, userId])
  @@index([venueId, createdAt])
}

// Padis the host invited from the "Invite padis" picker.
model EventInvite {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

// PadiRadar "hide from this padi" (the eye toggle). One-way and silent: the
// hider (userId) disappears from hiddenFrom's radar AND profile views, while
// the padi connection and chats stay intact. Not a Block (which is mutual and
// removes everything).
model RadarHide {
  userId       String
  user         User     @relation("RadarHider", fields: [userId], references: [id], onDelete: Cascade)
  hiddenFromId String
  hiddenFrom   User     @relation("RadarHiddenFrom", fields: [hiddenFromId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@id([userId, hiddenFromId])
  @@index([hiddenFromId])
}

// Peer rating between padis, unlocked only by a shared hangout (Padi Profile
// "Padi score"). Mirrors VenueReview: one rating per rater→ratee per event,
// re-submitting edits it. Score shown on cards/list/profile is the average.
model PadiRating {
  id        String   @id @default(uuid())
  raterId   String
  rater     User     @relation("PadiRater", fields: [raterId], references: [id], onDelete: Cascade)
  rateeId   String
  ratee     User     @relation("PadiRatee", fields: [rateeId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([raterId, rateeId, eventId])
  @@index([rateeId])
}
