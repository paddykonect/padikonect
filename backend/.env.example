# App
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3001

# Database (Postgres + PostGIS)
DATABASE_URL=postgresql://paddykonect:paddykonect@localhost:5433/paddykonect?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Sentry (optional in development)
SENTRY_DSN=

# --- Phase 1 (Auth) ---
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DEFAULT=24h
JWT_REFRESH_TTL_EXTENDED=60d
OTP_HASH_PEPPER=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Paddykonect <no-reply@paddykonect.com>"
# Contact-us messages are forwarded here (optional; always stored in the DB)
SUPPORT_EMAIL=support@paddykonect.com

# --- Added in Phase 2 (Profile / Cloudinary) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Added in Phase 4 (Padi Board / Events) ---
GOOGLE_MAPS_API_KEY=

# --- Added in Phase 5 (Payments) ---
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=
# FLUTTERWAVE_SECRET_KEY=

# --- Biometric login (WebAuthn/passkeys, Figma-only addition) ---
# RP_ID/ORIGIN must match the real frontend host in every environment.
WEBAUTHN_RP_NAME=Paddykonect
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001

# --- Google sign-in (OAuth 2.0 Web client ID from Google Cloud Console) ---
# Same value as the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
