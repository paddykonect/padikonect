# NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_API_URL=https://padikonect-api.onrender.com/api/v1

# Google sign-in: OAuth 2.0 Web client ID (same value as backend GOOGLE_CLIENT_ID).
# Leave empty to hide the Google button.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID="GOOGLE_CLIENT_ID=42007948876-np5saet9ta879adb7jog81fkis53pam5.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=42007948876-np5saet9ta879adb7jog81fkis53pam5.apps.googleusercontent.com

# Google Maps JavaScript API — a BROWSER key (it ships to the client, so lock it
# down by HTTP referrer in Google Cloud and enable only Maps JavaScript API).
# Maps show a "set your key" placeholder until this is filled in.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for Advanced Markers. Create one in Google Cloud (vector map) for
# production; DEMO_MAP_ID works for local dev (shows a watermark).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
